# Copy to deploy/.env privately. Do not copy the local development database.
# Generate four different 48-character hexadecimal database passwords.
ATLAS_IMAGE=atlas:resume-20260918
ATLAS_DOMAIN=atlas.example.com
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=
IDENTITY_DB_PASSWORD=
# Generate a Fernet key once; retain it with backups.
MFA_ENCRYPTION_KEY=
# The current email adapter supports authenticated SMTP with STARTTLS (e.g. 587).
# Implicit TLS-only port 465 is not configured by this deployment.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
